# Database (SQLite for development, PostgreSQL for production)
# Development:
DATABASE_URL="file:./dev.db"
# Production:
# DATABASE_URL="postgresql://user:password@localhost:5432/eduguard_ai"

# Authentication
# IMPORTANT: Generate your own random secrets before deploying (e.g. openssl rand -base64 32).
# Never use these example values in production.
JWT_SECRET="replace-with-a-random-64-char-secret-for-production-use-only"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-char-secret-for-prod"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Providers
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
AI_PROVIDER="groq"

# Fallback AI Provider #1 (Gemini - used automatically when Groq fails)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Fallback AI Provider #2 (OpenRouter - used when both Groq and Gemini fail)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-70b-instruct"

# Future providers
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Voice providers (future)
# ELEVENLABS_API_KEY=""
# WHISPER_API_KEY=""

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EduGuard AI"
NODE_ENV="development"

# Email (SMTP)
# Development: Leave empty — uses Ethereal (free test emails with preview URLs in console)
# Production: Configure SMTP credentials below
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@eduguard.ai"
